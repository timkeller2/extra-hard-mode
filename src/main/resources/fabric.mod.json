  "authors": [
    "Ryan 'BigScary' Hamshire (original)",
    "Diemex",
    "RoboMWM",
    "Mitsugaru",
    "Grok Design (26.3 Fabric port)"
  ],
  "license": "AGPL-3.0-or-later",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.extrahardmode.ExtraHardModeMod"
    ],
    "client": [
      "dev.extrahardmode.client.ExtraHardModeClient"
    ],
    "modmenu": [
      "dev.extrahardmode.client.ModMenuIntegration"
    ],
    "fabric-gametest": [
      "dev.extrahardmode.test.EhmGameTests"
    ]
  },
  "mixins": [
    "tougher.mixins.json",
    "tougher.iris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0+26.3",
